# HungryHut Server Environment Configuration Template
# Duplicate this file as .env and fill in your actual credentials.
# NEVER commit the actual .env file with production secrets to Git.

MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.pawcgi2.mongodb.net/healthcart?appName=Cluster0
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5000
JWT_SECRET=your_strong_random_jwt_secret_key_here
ADMIN_EMAIL=admin@hungryhut.com
ADMIN_PASSWORD=your_initial_admin_password
